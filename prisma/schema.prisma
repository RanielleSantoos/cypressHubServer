generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(120)
  description   String?  @db.VarChar(1000)
  repositoryUrl String?  @db.VarChar(2048)
  integrationKey String? @unique @db.VarChar(64)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  screens       Screen[]
  tests         TestCase[]
  schedules     Schedule[]

  @@index([createdAt, id])
}

model Screen {
  id        String     @id @default(uuid()) @db.Uuid
  projectId String     @db.Uuid
  name      String     @db.VarChar(120)
  route     String?    @db.VarChar(300)
  sourceDirectory String? @db.VarChar(1000)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  tests     TestCase[]
  schedules Schedule[]
  scheduleTargets ScheduleScreen[]

  @@unique([projectId, id])
  @@unique([projectId, sourceDirectory])
  @@index([projectId, name, id])
}

model TestCase {
  id        String     @id @default(uuid()) @db.Uuid
  projectId String     @db.Uuid
  screenId  String?    @db.Uuid
  name      String     @db.VarChar(120)
  specPath  String?    @db.VarChar(1000)
  specAvailable Boolean @default(true)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  screen    Screen?    @relation(fields: [projectId, screenId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  schedules Schedule[]

  @@unique([projectId, id])
  @@unique([projectId, specPath])
  @@index([projectId, name, id])
  @@index([screenId])
}

enum Recurrence {
  ONCE
  DAILY
  WEEKLY
}

model Schedule {
  id         String     @id @default(uuid()) @db.Uuid
  projectId  String     @db.Uuid
  screenId   String?    @db.Uuid
  testId     String?    @db.Uuid
  startAt    DateTime   @db.Timestamptz(3)
  recurrence Recurrence
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  screen     Screen?    @relation(fields: [projectId, screenId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  test       TestCase?  @relation(fields: [projectId, testId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  screenTargets ScheduleScreen[]

  @@unique([projectId, id])
  @@index([projectId, startAt, id])
  @@index([screenId])
  @@index([testId])
}

model ScheduleScreen {
  projectId  String   @db.Uuid
  scheduleId String   @db.Uuid
  screenId   String   @db.Uuid
  schedule   Schedule @relation(fields: [projectId, scheduleId], references: [projectId, id], onDelete: Cascade, onUpdate: Restrict)
  screen     Screen   @relation(fields: [projectId, screenId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([scheduleId, screenId])
  @@index([projectId, screenId])
}
