{
  "name": "cypress-hub-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "db:start": "node --env-file-if-exists=.env scripts/start-local-database.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.cjs",
    "test": "npm run build && node --test test/api.test.cjs test/discover-specs.test.cjs",
    "test:integration": "npm run build && node --env-file-if-exists=.env --test test/workspace.integration.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "~6.19.0",
    "class-transformer": "0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/node": "^24.0.0",
    "prisma": "~6.19.0",
    "typescript": "~5.9.3"
  }
}
